# ---- Database (Neon Postgres, free plan) ----
# Use the POOLED connection string from Neon (host contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ---- Auth (Better Auth) ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL of the site, no trailing slash
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google sign-in (optional). Create OAuth credentials in Google Cloud Console.
# Authorised redirect URI: <SITE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# First admin account, created by `npm run db:seed` if it doesn't exist.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# ---- Razorpay (test keys from Dashboard > Account & Settings > API Keys) ----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard > Webhooks. URL: <SITE_URL>/api/razorpay/webhook
# Events: payment.captured, payment.failed, order.paid, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=""

# ---- Image uploads in admin (optional, Vercel Blob) ----
BLOB_READ_WRITE_TOKEN=""
